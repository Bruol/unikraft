menuconfig PLAT_RPI5
	bool "Raspberry Pi 5"
	default n
	depends on ARCH_ARM_64
	imply LIBUKPM
	select LIBUKBOOT
	select LIBUKDEBUG
	select LIBUKBITOPS
	select LIBUKALLOC
	select LIBUKTIMECONV
	select LIBNOLIBC if !HAVE_LIBC
	select LIBUKPLAT_NATIVE_PAL
	select HAVE_INTCTLR
	select HAVE_FDT
	imply LIBFDT
	imply LIBUKOFW
	select LIBUKINTCTLR_GICV2
	help
		Build a fixed-address Unikraft image for direct Raspberry Pi 5
		firmware boot. Static PIE is not supported by this platform.

if PLAT_RPI5

config ARM_GENERIC_TIMER_PHYSICAL
	bool
	default y
	help
		Use the non-secure physical ARM generic timer (CNTP) rather than
		the virtual timer (CNTV). The timer interrupt is taken from DT
		interrupt tuple 1.

config RPI5_SINGLE_CORE_BOOT
	bool "Park secondary cores"
	default y
	help
		Park all non-boot cores while the first platform path is
		brought up.

config RPI5_EARLY_GDB_SPINLOOP
	bool "Stop in an early GDB spin loop"
	default y
	help
		Stop the boot CPU in a simple early spin loop before stack and
		BSS setup. In GDB, clear `x2` while stopped at the loop `nop`,
		or clear `rpi5_gdb_spin_flag`.

endif
