$(eval $(call addplat_s,rpi5,$(CONFIG_PLAT_RPI5)))

ifeq ($(CONFIG_PLAT_RPI5)$(CONFIG_OPTIMIZE_PIE),yy)
$(error plat/native/rpi5 requires a fixed-address image; CONFIG_OPTIMIZE_PIE is unsupported)
endif

$(eval $(call addplatlib,rpi5,librpi5plat))

LIBRPI5PLAT_ASINCLUDES-y += -I$(LIBRPI5PLAT_BASE)/include
LIBRPI5PLAT_ASINCLUDES-y += -I$(UK_PLAT_COMMON_BASE)/include
LIBRPI5PLAT_CINCLUDES-y  += -I$(LIBRPI5PLAT_BASE)/include
LIBRPI5PLAT_CINCLUDES-y  += -I$(UK_PLAT_COMMON_BASE)/include
LIBRPI5PLAT_CINCLUDES-y  += -I$(UK_PLAT_COMMON_BASE)

LIBRPI5PLAT_ASFLAGS += -DRPI5PLAT -DUK_USE_SECTION_SEGMENTS
LIBRPI5PLAT_CFLAGS  += -DRPI5PLAT -DUK_USE_SECTION_SEGMENTS

UK_PLAT_RPI5_DEF_LDS := $(LIBRPI5PLAT_BASE)/link64.lds.S

LIBRPI5PLAT_SRCS-y += $(LIBRPI5PLAT_BASE)/entry64.S|isr
LIBRPI5PLAT_SRCS-y += $(LIBRPI5PLAT_BASE)/reload64.S|isr
LIBRPI5PLAT_SRCS-y += $(LIBRPI5PLAT_BASE)/pagetable64.S|isr
LIBRPI5PLAT_SRCS-y += $(LIBRPI5PLAT_BASE)/setup.c
LIBRPI5PLAT_SRCS-y += $(LIBRPI5PLAT_BASE)/memory.c
LIBRPI5PLAT_SRCS-y += $(LIBRPI5PLAT_BASE)/pl011.c
LIBRPI5PLAT_SRCS-$(CONFIG_LIBFDT) += $(LIBRPI5PLAT_BASE)/bootinfo_fdt.c
LIBRPI5PLAT_SRCS-y += $(CONFIG_UK_BASE)/plat/kvm/arm/exceptions.S|isr

LIBRPI5PLAT_SRCS-y += $(UK_PLAT_COMMON_BASE)/bootinfo.c|common
LIBRPI5PLAT_SRCS-y += $(UK_PLAT_COMMON_BASE)/bootinfo.lds.S|common
LIBRPI5PLAT_SRCS-y += $(UK_PLAT_COMMON_BASE)/memory.c|common
LIBRPI5PLAT_SRCS-y += $(LIBRPI5PLAT_BASE)/time.c
LIBRPI5PLAT_SRCS-y += $(LIBRPI5PLAT_BASE)/generic_timer.c
LIBRPI5PLAT_SRCS-y += $(UK_PLAT_RPI5_DEF_LDS)
